# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://de_nest:de_nest_dev_password@localhost:5432/de_nest?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# --- Auth / JWT ---
# Generate strong random secrets for real deployments, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=changeme_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_REFRESH_TTL=30d

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- SMS provider adapter ---
# SMS_PROVIDER=mock | africastalking | twilio | clickatell
SMS_PROVIDER=mock
SMS_FROM=DeNest
# Provider-specific credentials (leave blank until a real provider is configured):
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CLICKATELL_API_KEY=

# --- Receipt / attachment storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/receipts

# --- Backups (Google Drive) ---
# BACKUP_STORAGE_DRIVER=local | google_drive
BACKUP_STORAGE_DRIVER=local
BACKUP_LOCAL_PATH=./storage/backups
BACKUP_ENCRYPTION_KEY=changeme_32_byte_backup_encryption_key
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *
#
# To back up to Google Drive instead of local disk:
#   1. In Google Cloud Console, create a project (or use an existing one)
#      and enable the "Google Drive API".
#   2. Create a Service Account, then create a JSON key for it and open it.
#   3. Set BACKUP_STORAGE_DRIVER=google_drive below.
#   4. GOOGLE_DRIVE_CLIENT_EMAIL = the JSON's "client_email".
#   5. GOOGLE_DRIVE_PRIVATE_KEY = the JSON's "private_key" (keep the \n
#      sequences literal, in quotes, e.g. "-----BEGIN PRIVATE KEY-----\n...").
#   6. Create (or pick) a Drive folder for backups, share it with the
#      service account's email as an Editor, and put its folder ID (the
#      long id in the folder's URL) in GOOGLE_DRIVE_FOLDER_ID below.
# Until all three GOOGLE_DRIVE_* values are set, the app falls back to
# local disk automatically even if BACKUP_STORAGE_DRIVER=google_drive.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Offline prepaid safe-limit ---
OFFLINE_PREPAID_FRESHNESS_HOURS=24
OFFLINE_PREPAID_PER_TX_CAP=500

# --- Seed data ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme_admin_password
